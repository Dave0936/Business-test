# ---------------------------------------------------------------------------
# WebOpportunity AI — environment template. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values are ever sent to the browser.
# ---------------------------------------------------------------------------

# App URL (used in auth emails and, later, unsubscribe links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Required: Supabase (Phase 1) -------------------------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for background jobs and for inviting team members.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. 32 random bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Optional integrations (later phases). Missing = clearly labelled demo/off mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_PLACES_API_KEY=
# OpenStreetMap usage policy asks for a contact address in the User-Agent
OSM_CONTACT_EMAIL=
PINTEREST_ACCESS_TOKEN=
UNSPLASH_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_PREFIX=wo
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Optional real-browser checks (need Playwright + Chromium on the server)
AUDIT_BROWSER=false
QA_BROWSER=false
